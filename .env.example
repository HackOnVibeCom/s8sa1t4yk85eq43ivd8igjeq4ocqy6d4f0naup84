# CANIGO AI Assistant & Platform Environment Configuration Template
# Copy this file to .env and fill in your local configuration.
# Keep the Gemini key server-side; never prefix it with VITE_.
GEMINI_API_KEY=your_gemini_api_key_here
# Supabase URL and anon/publishable key are safe for the browser when RLS is enabled.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
