# Required. Local SQLite file, relative to the prisma/ folder.
DATABASE_URL="file:./dev.db"

# Optional self-hosted OpenAI-compatible endpoint serving an open-weights vision model.
# Leave empty to run without AI. Example: http://127.0.0.1:11434/v1
OPEN_SOURCE_VISION_API_URL=
OPEN_SOURCE_VISION_API_KEY=
OPEN_SOURCE_VISION_MODEL=Qwen2.5-VL-7B-Instruct
AI_ANALYSIS_ENABLED=false

# Optional map tile / geocoding endpoints.
MAP_TILE_PROVIDER_URL=
MAP_GEOCODING_PROVIDER_URL=

# Keep true for the local labeled demo experience.
NEXT_PUBLIC_DEMO_MODE=true
